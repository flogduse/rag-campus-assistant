# Copy to .env and fill in what you have. Everything is optional.

# --- LLM provider (pick ONE; auto-detected in this order) ---
# 1) Groq — free tier, fastest path. Key from https://console.groq.com/keys
GROQ_API_KEY=
# 2) OpenAI
OPENAI_API_KEY=
# 3) Ollama (local, no key): install from https://ollama.com then:
#    ollama pull llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Model overrides (defaults shown)
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4o-mini

# --- Retrieval / chunking knobs ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
FETCH_K=12

# --- Generation ---
LLM_TEMP=0.2
LLM_MAX_TOKENS=700
